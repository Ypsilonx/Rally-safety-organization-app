# Rally Safety App Configuration

# App settings
APP_NAME=Rally Safety App
APP_VERSION=0.1.0
# DEBUG zapíná /api/debug/pins (výpis všech PINů bez auth) a auto-reload.
# Pro lokální vývoj True, PŘED OSTRÝM NASAZENÍM VŽDY False (kód defaultuje
# na False, takže i zapomenutá/chybějící proměnná je bezpečná).
DEBUG=True

# Server settings
HOST=0.0.0.0
PORT=8000
RELOAD=True

# CORS - čárkou oddělený seznam originů frontendu pro produkci, např.:
# ALLOWED_ORIGINS=https://rally.example.com,https://admin.rally.example.com
# "*" (výchozí) je v pořádku jen pro lokální vývoj.
ALLOWED_ORIGINS=*

# WebSocket settings
WS_MAX_CONNECTIONS=200
WS_HEARTBEAT_INTERVAL=30

# Auth settings
SESSION_EXPIRE_MINUTES=480

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs
